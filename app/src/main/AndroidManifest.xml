<?xml version="1.0" encoding="utf-8"?>
<!--
  HomeNurse — native Android, privacy-first, local-AI healthcare assistant.

  Deliberate privacy decisions in this file:
    * android:allowBackup="false"  — medical data must never reach cloud backup.
    * Explicit backup/data-extraction rules (ignored while allowBackup=false,
      kept as belt-and-suspenders for OEM data-transfer implementations).
    * android:usesCleartextTraffic="false" + network security config — the only
      network traffic is the user-triggered model download over HTTPS.
    * No analytics, no crash-reporting, no advertising identifiers.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Used ONLY for downloading the Gemma model and checking app updates.
         No medical data is ever sent over the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Camera capture of medical documents (processed fully on-device). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Medication / care reminders. Notification content is privacy-safe by default. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:name=".HomeNurseApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.HomeNurse"
        android:usesCleartextTraffic="false"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.HomeNurse"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Cache-file sharing (user-initiated JSON export via share sheet). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
