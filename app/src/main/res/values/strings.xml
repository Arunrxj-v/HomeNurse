    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Welcome to HomeNurse</string>
    <string name="onboarding_welcome_body">Your personal health assistant. It reads your medical papers, keeps your medicines and care tasks in one place, and answers your questions — all on this phone.</string>
    <string name="onboarding_continue">Continue</string>

    <string name="onboarding_privacy_title">Your medical information stays on this phone</string>
    <string name="onboarding_privacy_body">HomeNurse is built so that your private health data never leaves your device.</string>
    <string name="onboarding_privacy_bullet_1">Documents are stored encrypted, inside this app only.</string>
    <string name="onboarding_privacy_bullet_2">Your documents, medicines, care plans and chat are never uploaded anywhere.</string>
    <string name="onboarding_privacy_bullet_3">Backups of app data are deliberately disabled.</string>

    <string name="onboarding_local_title">The AI runs locally</string>
    <string name="onboarding_local_body">HomeNurse uses a Gemma language model that runs on this phone. Once it is downloaded, everything works without internet — even in airplane mode.</string>
    <string name="onboarding_local_bullet_1">Questions and documents are processed on this device only.</string>
    <string name="onboarding_local_bullet_2">No medical text is ever sent to an AI service or cloud.</string>
    <string name="onboarding_local_bullet_3">The model is downloaded once from HomeNurse\'s own server, over HTTPS, and is checksum-verified.</string>

    <string name="onboarding_signin_title">Sign in or create account</string>
    <string name="onboarding_signin_body">Sign in so HomeNurse can protect your account and deliver AI model updates. Only your account details are sent — never your medical information.</string>
    <string name="onboarding_signin_button">Continue</string>
    <string name="onboarding_signed_in_as">Signed in as %1$s</string>

