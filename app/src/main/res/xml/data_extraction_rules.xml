<?xml version="1.0" encoding="utf-8"?>
<!--
  HomeNurse privacy: medical files and databases must not be copied by
  device-to-device transfer or cloud backup under any circumstances.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
