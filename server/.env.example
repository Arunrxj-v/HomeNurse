# HomeNurse server — environment configuration (TEMPLATE ONLY, no secrets).
# Copy to server/.env and fill in real values. NEVER commit server/.env.

# --- Runtime -----------------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=8080
# Bind address. Keep 127.0.0.1: nginx on the HomeServer fronts this API over
# HTTPS (Tailscale MagicDNS hostname) and is the only client that needs to
# reach the port. Exposing 0.0.0.0 in production is rejected at startup.
HOST=127.0.0.1
# Public origin used to build model downloadUrl / noticeUrl (no trailing slash).
# The HomeServer deployment uses the dedicated tailnet-only Tailscale serve
# listener on 8443 (port 443 carries a public Funnel'd site on that box, and
# funnel is flagged per hostname:port, so the API must not share it):
PUBLIC_BASE_URL=https://server.tailda589d.ts.net:8443/homenurse
# Set when behind a TLS-terminating proxy (enables req.secure and HSTS).
# Examples: 1 | true | loopback | 127.0.0.1
TRUST_PROXY=loopback

# --- Auth --------------------------------------------------------------------
# REQUIRED in production, minimum 32 characters. Generate one with:
#   openssl rand -base64 48
# Left empty outside production, a clearly-marked insecure dev fallback is used.
JWT_SECRET=
# Access JWT lifetime in seconds (default 900 = 15 minutes).
ACCESS_TOKEN_TTL=900
# Opaque refresh token lifetime in seconds (default 2592000 = 30 days).
REFRESH_TOKEN_TTL=2592000
# Password-reset token lifetime in seconds (default 1800 = 30 minutes).
RESET_TOKEN_TTL=1800

# --- Google Sign-In (optional) ----------------------------------------------
# Without this, POST /auth/google returns 501 google_not_configured.
GOOGLE_CLIENT_ID=

# --- Password-reset email ----------------------------------------------------
# console | smtp
EMAIL_PROVIDER=console
# Required only when EMAIL_PROVIDER=smtp.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HomeNurse <no-reply@homenurse.example>"

# --- Storage (relative paths resolve against server/) -----------------------
DATA_DIR=./data
MODELS_DIR=./models-store

# --- Operational flags -------------------------------------------------------
# Token for scripts/publish-model.js operators (unused over HTTP by design).
ADMIN_TOKEN=
# 1 disables every rate limiter (the test suite runs with this).
RATE_LIMIT_DISABLED=0
# 1 logs the raw password-reset token — DEVELOPMENT ONLY.
# It is never logged when NODE_ENV=production, regardless of this flag.
DEBUG_RESET_TOKENS=0
